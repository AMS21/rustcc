; ModuleID = 'add_variables.c'
source_filename = "add_variables.c"

define i32 @main() {
entry:
  %first_variable = alloca i32, align 4
  store i32 1, ptr %first_variable, align 4
  %second_variable = alloca i32, align 4
  store i32 2, ptr %second_variable, align 4
  %first_variable.load = load i32, ptr %first_variable, align 4
  %second_variable.load = load i32, ptr %second_variable, align 4
  %add = add i32 %first_variable.load, %second_variable.load
  ret i32 %add
}
