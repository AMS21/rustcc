; ModuleID = 'and_true.c'
source_filename = "and_true.c"

define i32 @main() {
entry:
  br i1 true, label %land.rhs, label %land.false

land.rhs:                                         ; preds = %entry
  br i1 true, label %land.true, label %land.false

land.false:                                       ; preds = %land.rhs, %entry
  br label %land.end

land.true:                                        ; preds = %land.rhs
  br label %land.end

land.end:                                         ; preds = %land.false, %land.true
  %land.phi = phi i32 [ 1, %land.true ], [ 0, %land.false ]
  ret i32 %land.phi
}
