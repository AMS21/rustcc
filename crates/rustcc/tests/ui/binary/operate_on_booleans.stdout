; ModuleID = 'operate_on_booleans.c'
source_filename = "operate_on_booleans.c"

define i32 @main() {
entry:
  br i1 false, label %land.rhs, label %land.false

land.rhs:                                         ; preds = %entry
  br i1 true, label %land.true, label %land.false

land.false:                                       ; preds = %land.rhs, %entry
  br label %land.end

land.true:                                        ; preds = %land.rhs
  br label %land.end

land.end:                                         ; preds = %land.false, %land.true
  %land.phi = phi i32 [ 1, %land.true ], [ 0, %land.false ]
  %not = xor i32 %land.phi, -1
  br i1 true, label %lor.true, label %lor.rhs

lor.rhs:                                          ; preds = %land.end
  br i1 true, label %lor.true, label %lor.false

lor.true:                                         ; preds = %lor.rhs, %land.end
  br label %lor.end

lor.false:                                        ; preds = %lor.rhs
  br label %lor.end

lor.end:                                          ; preds = %lor.false, %lor.true
  %lor.phi = phi i32 [ 1, %lor.true ], [ 0, %lor.false ]
  %neg = sub i32 0, %lor.phi
  %sub = sub i32 %not, %neg
  ret i32 %sub
}
