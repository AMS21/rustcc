; ModuleID = 'rustcc/tests/input/parser/postfix_precedence.c'
source_filename = "rustcc/tests/input/parser/postfix_precedence.c"

define i32 @main() {
entry:
  %a = alloca i32, align 4
  store i32 1, ptr %a, align 4
  %b = alloca i32, align 4
  %a.load = load i32, ptr %a, align 4
  %add = add i32 %a.load, 1
  store i32 %add, ptr %a, align 4
  %icmp_eq = icmp eq i32 %a.load, 0
  %zext = zext i1 %icmp_eq to i32
  store i32 %zext, ptr %b, align 4
  %a.load1 = load i32, ptr %a, align 4
  %icmp_eq2 = icmp eq i32 %a.load1, 2
  %zext3 = zext i1 %icmp_eq2 to i32
  %icmp_ne = icmp ne i32 %zext3, 0
  br i1 %icmp_ne, label %land.rhs, label %land.false

land.rhs:                                         ; preds = %entry
  %b.load = load i32, ptr %b, align 4
  %icmp_eq4 = icmp eq i32 %b.load, 0
  %zext5 = zext i1 %icmp_eq4 to i32
  %icmp_ne6 = icmp ne i32 %zext5, 0
  br i1 %icmp_ne6, label %land.true, label %land.false

land.false:                                       ; preds = %land.rhs, %entry
  br label %land.end

land.true:                                        ; preds = %land.rhs
  br label %land.end

land.end:                                         ; preds = %land.false, %land.true
  %land.phi = phi i32 [ 1, %land.true ], [ 0, %land.false ]
  ret i32 %land.phi
}
