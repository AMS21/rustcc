source_filename = "rustcc/tests/input/parser/compound_multiply.c"

define i32 @main() {
entry:
  %to_multiply = alloca i32, align 4
  store i32 4, ptr %to_multiply, align 4
  %to_multiply.load = load i32, ptr %to_multiply, align 4
  %mul = mul i32 %to_multiply.load, 3
  store i32 %mul, ptr %to_multiply, align 4
  %to_multiply.load1 = load i32, ptr %to_multiply, align 4
  ret i32 %to_multiply.load1
}
