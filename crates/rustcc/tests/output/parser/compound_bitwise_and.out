define i32 @main() {
entry:
  %to_and = alloca i32, align 4
  store i32 3, ptr %to_and, align 4
  %to_and.load = load i32, ptr %to_and, align 4
  %and = and i32 %to_and.load, 6
  store i32 %and, ptr %to_and, align 4
  %to_and.load1 = load i32, ptr %to_and, align 4
  ret i32 %to_and.load1
}
