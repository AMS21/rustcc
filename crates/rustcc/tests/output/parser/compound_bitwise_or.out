define i32 @main() {
entry:
  %to_or = alloca i32, align 4
  store i32 1, ptr %to_or, align 4
  %to_or.load = load i32, ptr %to_or, align 4
  %or = or i32 %to_or.load, 30
  store i32 %or, ptr %to_or, align 4
  %to_or.load1 = load i32, ptr %to_or, align 4
  ret i32 %to_or.load1
}
