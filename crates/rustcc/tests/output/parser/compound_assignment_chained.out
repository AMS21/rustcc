land.end35:                                       ; preds = %land.false32, %land.true33
  %land.phi34 = phi i32 [ 1, %land.true33 ], [ 0, %land.false32 ]
  %icmp_ne36 = icmp ne i32 %land.phi34, 0
  br i1 %icmp_ne36, label %land.rhs37, label %land.false41

land.rhs37:                                       ; preds = %land.end35
  %f.load = load i32, ptr %f, align 4
  %icmp_eq38 = icmp eq i32 %f.load, -7
  %zext39 = zext i1 %icmp_eq38 to i32
  %icmp_ne40 = icmp ne i32 %zext39, 0
  br i1 %icmp_ne40, label %land.true42, label %land.false41

land.false41:                                     ; preds = %land.rhs37, %land.end35
  br label %land.end44

land.true42:                                      ; preds = %land.rhs37
  br label %land.end44

land.end44:                                       ; preds = %land.false41, %land.true42
  %land.phi43 = phi i32 [ 1, %land.true42 ], [ 0, %land.false41 ]
  %icmp_ne45 = icmp ne i32 %land.phi43, 0
  br i1 %icmp_ne45, label %land.rhs46, label %land.false50

land.rhs46:                                       ; preds = %land.end44
  %x.load = load i32, ptr %x, align 4
  %icmp_eq47 = icmp eq i32 %x.load, 2250
  %zext48 = zext i1 %icmp_eq47 to i32
  %icmp_ne49 = icmp ne i32 %zext48, 0
  br i1 %icmp_ne49, label %land.true51, label %land.false50

land.false50:                                     ; preds = %land.rhs46, %land.end44
  br label %land.end53

land.true51:                                      ; preds = %land.rhs46
