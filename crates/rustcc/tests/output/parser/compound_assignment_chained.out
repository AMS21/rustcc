  %sdiv = sdiv i32 %d.load, %srem
  store i32 %sdiv, ptr %d, align 4
  %mul = mul i32 %c.load, %sdiv
  store i32 %mul, ptr %c, align 4
  %sub = sub i32 %b.load, %mul
  store i32 %sub, ptr %b, align 4
  %add = add i32 %a.load, %sub
