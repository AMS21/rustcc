define i32 @main() {
entry:
  %a = alloca i32, align 4
  store i32 15, ptr %a, align 4
  %b = alloca i32, align 4
  %a.load = load i32, ptr %a, align 4
  %xor = xor i32 %a.load, 5
  store i32 %xor, ptr %b, align 4
  %b.load = load i32, ptr %b, align 4
  %or = or i32 1, %b.load
  ret i32 %or
}
