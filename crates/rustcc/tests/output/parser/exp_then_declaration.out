define i32 @main() {
entry:
  %a = alloca i32, align 4
  store i32 -2593, ptr %a, align 4
  %a.load = load i32, ptr %a, align 4
  %srem = srem i32 %a.load, 3
  store i32 %srem, ptr %a, align 4
  %b = alloca i32, align 4
  %a.load1 = load i32, ptr %a, align 4
  %neg = sub i32 0, %a.load1
  store i32 %neg, ptr %b, align 4
  %b.load = load i32, ptr %b, align 4
  ret i32 %b.load
}
