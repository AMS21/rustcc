; ModuleID = 'rustcc/tests/input/parser/non_short_circuit_or.c'
source_filename = "rustcc/tests/input/parser/non_short_circuit_or.c"

define i32 @main() {
entry:
  %a = alloca i32, align 4
  store i32 0, ptr %a, align 4
  br i1 false, label %lor.true, label %lor.rhs

lor.rhs:                                          ; preds = %entry
  store i32 1, ptr %a, align 4
  br i1 true, label %lor.true, label %lor.false

lor.true:                                         ; preds = %lor.rhs, %entry
  br label %lor.end

lor.false:                                        ; preds = %lor.rhs
  br label %lor.end

lor.end:                                          ; preds = %lor.false, %lor.true
  %lor.phi = phi i32 [ 1, %lor.true ], [ 0, %lor.false ]
  %a.load = load i32, ptr %a, align 4
  ret i32 %a.load
}
