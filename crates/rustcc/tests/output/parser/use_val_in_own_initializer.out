source_filename = "rustcc/tests/input/parser/use_val_in_own_initializer.c"

define i32 @main() {
entry:
  %a = alloca i32, align 4
  br i1 false, label %land.rhs, label %land.false

land.rhs:                                         ; preds = %entry
  %a.load = load i32, ptr %a, align 4
  %icmp_ne = icmp ne i32 %a.load, 0
  br i1 %icmp_ne, label %land.true, label %land.false

land.false:                                       ; preds = %land.rhs, %entry
  br label %land.end

land.true:                                        ; preds = %land.rhs
  br label %land.end

land.end:                                         ; preds = %land.false, %land.true
  %land.phi = phi i32 [ 1, %land.true ], [ 0, %land.false ]
  store i32 %land.phi, ptr %a, align 4
  %a.load1 = load i32, ptr %a, align 4
  ret i32 %a.load1
}
