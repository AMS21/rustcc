define i32 @main() {
entry:
  %var_to_shift = alloca i32, align 4
  store i32 1234, ptr %var_to_shift, align 4
  %x = alloca i32, align 4
  store i32 0, ptr %x, align 4
  %var_to_shift.load = load i32, ptr %var_to_shift, align 4
  %ashr = ashr i32 %var_to_shift.load, 4
  store i32 %ashr, ptr %x, align 4
  %x.load = load i32, ptr %x, align 4
  ret i32 %x.load
}
