define i32 @main() {
entry:
  %a = alloca i32, align 4
  store i32 1, ptr %a, align 4
  %b = alloca i32, align 4
  store i32 2, ptr %b, align 4
  %c = alloca i32, align 4
  %a.load = load i32, ptr %a, align 4
  %add = add i32 %a.load, 1
  store i32 %add, ptr %a, align 4
  %neg = sub i32 0, %add
  store i32 %neg, ptr %c, align 4
  %d = alloca i32, align 4
  %b.load = load i32, ptr %b, align 4
  %sub = sub i32 %b.load, 1
  store i32 %sub, ptr %b, align 4
  %icmp_eq = icmp eq i32 %b.load, 0
  %zext = zext i1 %icmp_eq to i32
  store i32 %zext, ptr %d, align 4
  %a.load1 = load i32, ptr %a, align 4
  %icmp_eq2 = icmp eq i32 %a.load1, 2
  %zext3 = zext i1 %icmp_eq2 to i32
  %icmp_ne = icmp ne i32 %zext3, 0
  br i1 %icmp_ne, label %land.rhs, label %land.false

land.rhs:                                         ; preds = %entry
  %b.load4 = load i32, ptr %b, align 4
  %icmp_eq5 = icmp eq i32 %b.load4, 1
  %zext6 = zext i1 %icmp_eq5 to i32
  %icmp_ne7 = icmp ne i32 %zext6, 0
  br i1 %icmp_ne7, label %land.true, label %land.false

land.false:                                       ; preds = %land.rhs, %entry
  br label %land.end

land.true:                                        ; preds = %land.rhs
  br label %land.end

land.end:                                         ; preds = %land.false, %land.true
  %land.phi = phi i32 [ 1, %land.true ], [ 0, %land.false ]
  %icmp_ne8 = icmp ne i32 %land.phi, 0
  br i1 %icmp_ne8, label %land.rhs9, label %land.false13

land.rhs9:                                        ; preds = %land.end
  %c.load = load i32, ptr %c, align 4
  %icmp_eq10 = icmp eq i32 %c.load, -2
  %zext11 = zext i1 %icmp_eq10 to i32
  %icmp_ne12 = icmp ne i32 %zext11, 0
  br i1 %icmp_ne12, label %land.true14, label %land.false13

land.false13:                                     ; preds = %land.rhs9, %land.end
  br label %land.end16

land.true14:                                      ; preds = %land.rhs9
  br label %land.end16

land.end16:                                       ; preds = %land.false13, %land.true14
  %land.phi15 = phi i32 [ 1, %land.true14 ], [ 0, %land.false13 ]
  %icmp_ne17 = icmp ne i32 %land.phi15, 0
  br i1 %icmp_ne17, label %land.rhs18, label %land.false22

land.rhs18:                                       ; preds = %land.end16
  %d.load = load i32, ptr %d, align 4
  %icmp_eq19 = icmp eq i32 %d.load, 0
  %zext20 = zext i1 %icmp_eq19 to i32
  %icmp_ne21 = icmp ne i32 %zext20, 0
  br i1 %icmp_ne21, label %land.true23, label %land.false22

land.false22:                                     ; preds = %land.rhs18, %land.end16
  br label %land.end25

land.true23:                                      ; preds = %land.rhs18
  br label %land.end25

land.end25:                                       ; preds = %land.false22, %land.true23
  %land.phi24 = phi i32 [ 1, %land.true23 ], [ 0, %land.false22 ]
  ret i32 %land.phi24
}
