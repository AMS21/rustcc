; ModuleID = 'rustcc/tests/input/codegen/assign_in_short_circuit_and_initializer.c'
source_filename = "rustcc/tests/input/codegen/assign_in_short_circuit_and_initializer.c"

define i32 @a() {
entry:
  %a = alloca i32, align 4
  br i1 false, label %land.rhs, label %land.false

land.rhs:                                         ; preds = %entry
  store i32 5, ptr %a, align 4
  br i1 true, label %land.true, label %land.false

land.false:                                       ; preds = %land.rhs, %entry
  br label %land.end

land.true:                                        ; preds = %land.rhs
  br label %land.end

land.end:                                         ; preds = %land.false, %land.true
  %land.phi = phi i32 [ 1, %land.true ], [ 0, %land.false ]
  store i32 %land.phi, ptr %a, align 4
  %a.load = load i32, ptr %a, align 4
  unreachable
}
